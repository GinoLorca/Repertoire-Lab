# Firebase web config for sync (Settings → Account). Copy to .env.local for
# local development, and set the same names in Netlify under
# Project configuration → Environment variables for the deployed site.
#
# Not secrets: a web Firebase config is readable in any built bundle. The
# security rules in firebase/ are what restrict each account to its own data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
