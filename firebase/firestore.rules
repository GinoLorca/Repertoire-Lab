rules_version = '2';

// Four kinds of data, four rules.
//
// 1. Your own stuff — the repertoire, progress, games, settings. Nobody else
//    can write it, ever. A coach can read it, but only for as long as an
//    active link (see 4) says the student let them in.
// 2. Screen names — a public directory, so a coach can send to "wavy" without
//    knowing anything else about them. Readable by any signed-in account,
//    writable only by the account that owns it, and never re-writable to a
//    different uid once claimed.
// 3. Deliveries — a coach sending lines to a student. The sender creates it,
//    the recipient reads it and marks it accepted. Neither can read anyone
//    else's, and nobody can rewrite a delivery's contents after the fact.
// 4. Links — a coach asking to see a student's real account (games,
//    repertoire, everything) instead of the coach's own manual notes about
//    them. The coach starts it, only the student can let them in, and either
//    side can end it by deleting the link.
service cloud.firestore {
  match /databases/{database}/documents {

    // Fixed so there's only ever one link per coach/student pair — no way to
    // create a second one to route around a decline or a revoke.
    function linkId(coachUid, studentUid) {
      return coachUid + '_' + studentUid;
    }
    function isActiveCoachOf(studentUid) {
      return exists(/databases/$(database)/documents/links/$(linkId(request.auth.uid, studentUid)))
        && get(/databases/$(database)/documents/links/$(linkId(request.auth.uid, studentUid))).data.status == 'active';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // A coach the student has linked can see all of it — never write any
      // of it, and only while the link is active.
      allow read: if request.auth != null && isActiveCoachOf(uid);
    }

    match /screenNames/{name} {
      allow read: if request.auth != null;
      // Claim a free name, or re-save your own. The uid in the document must
      // be the account writing it, so a name can't be pointed at someone else.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /deliveries/{id} {
      // Only the two people involved can see it.
      allow read: if request.auth != null
                  && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      // Anyone signed in can send, but only as themselves — the sender can't
      // forge who it came from, which is what makes the student's "from" line
      // trustworthy.
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.size() < 30;
      // The recipient can mark it read or accepted, and that's all: the
      // payload and the sender are fixed once sent. A coach can withdraw
      // something they sent by deleting it.
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['readAt', 'acceptedAt', 'dismissedAt']);
      allow delete: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /links/{id} {
      // Only the two people involved can see it.
      allow read: if request.auth != null
                  && (resource.data.coachUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      // A coach starts a link, always pending, always as themselves, and
      // always at the one id their pairing with that student is allowed to
      // use.
      allow create: if request.auth != null
                    && request.resource.data.coachUid == request.auth.uid
                    && request.resource.data.studentUid is string
                    && request.resource.data.status == 'pending'
                    && id == linkId(request.auth.uid, request.resource.data.studentUid);
      // Only the student can approve a pending request, and that's the only
      // change this allows — nobody can flip an existing link back to
      // "active" after it's been declined or revoked, or touch who it's
      // between.
      allow update: if request.auth != null
                    && resource.data.studentUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
                    && request.resource.data.status == 'active';
      // Either side can end it: the coach withdrawing a request, or the
      // student declining one or cutting off an existing link.
      allow delete: if request.auth != null
                    && (resource.data.coachUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
    }
  }
}
