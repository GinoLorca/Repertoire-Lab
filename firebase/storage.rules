rules_version = '2';

// Same model as Firestore, for the things too big to sit in a document:
// opening artwork, player avatars, scoresheet photos, theme wallpapers and
// custom sounds. Each account reads and writes only under its own uid.
//
// The size cap is a guard against a runaway upload, not a policy — 20 MB is
// far above artwork or a wallpaper and far below anything that would quietly
// run up a bill.
//
// Not live until published, same as firestore.rules — but this one stays a
// paste job: `npm run deploy:rules` deliberately doesn't touch Storage,
// because the project has no bucket (free plan) and a deploy that tries
// would fail. Firebase console → Storage → Rules → Publish, if a bucket is
// ever added.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{path=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
