rules_version = '2';

// Same model as Firestore, for the things too big to sit in a document:
// opening artwork, player avatars, scoresheet photos, theme wallpapers and
// custom sounds. Each account reads and writes only under its own uid.
//
// The size cap is a guard against a runaway upload, not a policy — 20 MB is
// far above artwork or a wallpaper and far below anything that would quietly
// run up a bill.
//
// Chapter videos (src/lib/cloud/videos.js) are the exception to the 20 MB
// cap: up to 800 MB each, the app's own limit, and only video files.
//
// Not live until published, same as firestore.rules: `npm run deploy:rules`
// publishes both, or Firebase console → Storage → Rules → Publish.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{path=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024;
    }
    match /users/{uid}/videos/{videoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 800 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
